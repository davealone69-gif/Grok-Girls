<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup was "true", which let Android Auto Backup copy the
         WebView's localStorage (which holds the user's provider API keys) to
         Google Drive and adb backup. This app is explicitly phone-local, so
         backup is disabled outright. dataExtractionRules covers Android 12+
         (cloud backup + device-to-device transfer). -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Native 3D avatar viewport (Kotlin/GLES3 engine). Launched from
             the web app via AvatarStudioPlugin; not exported. -->
        <activity
            android:name=".NativeAvatarActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- HD renderer: OpenGL ES 3.2 (mirrors the native manifest's
         glEsVersion 0x00030002 requirement) -->
    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the app start "ollama serve" in Termux (auto-start layer).
         Harmless when Termux is absent: the bridge reports it and the
         user starts the server manually. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Needed on Android 11+ to detect/launch Termux at all. -->
    <queries>
        <package android:name="com.termux" />
    </queries>
</manifest>
