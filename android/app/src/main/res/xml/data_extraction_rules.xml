<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer policy.

  The app is phone-local by design and its WebView localStorage holds the
  user's provider API keys, chat logs and gallery. None of that may leave
  the device, so both cloud backup and device-to-device transfer are
  excluded entirely.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
