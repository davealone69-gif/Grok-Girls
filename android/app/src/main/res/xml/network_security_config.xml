<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed ONLY for loopback and RFC1918 LAN addresses.
  Loopback carries the two phone-local servers:
    127.0.0.1:11434 — Ollama (text / LLM)
    127.0.0.1:1234  — sd-server (Stable Diffusion images)
  LAN covers the optional self-hosted A1111/ComfyUI render server.
  domain-config is port-agnostic, so both loopback ports are covered by
  the 127.0.0.1 entry. Everything else stays HTTPS-only, so this does
  not weaken the app generally.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <!--
      cleartext stays permitted at the base level ONLY because the optional
      self-hosted A1111/ComfyUI feature points at a LAN address the user
      types in (e.g. http://192.168.1.50:8188). Android's network security
      config cannot express "RFC1918 only" — domain entries are exact hosts,
      not CIDR ranges — so a LAN-capable app cannot narrow this further.
      The domain-config above is therefore documentation of intent, not an
      additional restriction.

      User-installed CAs are NOT trusted. Trusting the "user" store lets
      anyone who can install a certificate profile on the phone silently
      intercept the app's HTTPS traffic; nothing in this app needs it.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
