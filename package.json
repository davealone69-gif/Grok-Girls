{
  "name": "grok-girls",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "overrides": {
    "rimraf": {
      "glob": "14.0.2"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
