<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================================= -->
<!-- Grok Girls — native Android layout/menu format                     -->
<!--                                                                   -->
<!-- The app parses this file at boot and renders the navigation rail, -->
<!-- the preview header actions, the camera-angle strip and the        -->
<!-- options panel from it. android:id / android:text drive the menu;  -->
<!-- android:contentDescription sets the hover tooltip.                -->
<!--                                                                   -->
<!-- Fault-tolerance: the parser is strict — a missing, malformed or   -->
<!-- structurally invalid file falls back to the built-in layout       -->
<!-- (DEFAULT_MENU in src/services/menuXml.ts), and the automated      -->
<!-- suites test that against a deliberately FAULTY copy.              -->
<!--                                                                   -->
<!-- Responsive mapping (the layout is authored landscape-first):      -->
<!--  - wide screens: rail | preview | options panel (3 columns)       -->
<!--  - portrait phones: rail | preview, options panel stacks below;   -->
<!--    SAVE/GENERATE stay tappable above the Android nav bar          -->
<!-- ================================================================= -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#101217">

    <!-- LEFT NAVIGATION -->
    <LinearLayout
        android:id="@+id/navigationRail"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="8dp"
        android:background="#171A21">

        <TextView
            android:id="@+id/railHeader"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="BUILD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button android:id="@+id/btnBuilder" android:text="Builder" android:contentDescription="Appearance Studio" />
        <Button android:id="@+id/btnPresets" android:text="Presets" android:contentDescription="Preset Identities" />
        <Button android:id="@+id/btnImport" android:text="Import" android:contentDescription="Import &amp; Data" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <Button android:id="@+id/btnBody" android:text="Body" android:contentDescription="Body &amp; Build" />
        <Button android:id="@+id/btnClothing" android:text="Clothing" android:contentDescription="Lingerie &amp; Corsetry" />
        <Button android:id="@+id/btnHair" android:text="Hair" android:contentDescription="Hair Styling" />
        <Button android:id="@+id/btnFace" android:text="Face" android:contentDescription="Face &amp; Makeup" />
        <Button android:id="@+id/btnEyes" android:text="Eyes" android:contentDescription="Eyes &amp; Eyeliner" />
        <Button android:id="@+id/btnAccessories" android:text="Accessories" android:contentDescription="Chokers &amp; Accessories" />
        <Button android:id="@+id/btnAugments" android:text="Augments" android:contentDescription="Augments" />
        <Button android:id="@+id/btnTattoos" android:text="Tattoos" android:contentDescription="Tattoos &amp; Lace" />
        <Button android:id="@+id/btnAnimations" android:text="Animations" android:contentDescription="Video &amp; Animation Studio" />
        <Button android:id="@+id/btnStory" android:text="Story" android:contentDescription="Story Campaign" />
        <Button android:id="@+id/btnGallery" android:text="Gallery" android:contentDescription="Generation Archive" />
        <Button android:id="@+id/btnPremium" android:text="Premium" android:contentDescription="Premium &amp; Upgrades" />
        <Button android:id="@+id/btnChat" android:text="Chat" android:contentDescription="Interactive Dialogue" />

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <Button android:id="@+id/btnHelp" android:text="?" android:contentDescription="Help &amp; Shortcuts" />
        <Button android:id="@+id/btnSettings" android:text="⚙" android:contentDescription="AI Provider Settings" />
    </LinearLayout>

    <!-- MAIN PREVIEW -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AVATAR DESIGNER"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button android:id="@+id/btnGenerate" android:text="GENERATE RENDER" android:contentDescription="Generate high-detail render" />
            <Button android:id="@+id/btnRandom" android:text="Random" android:contentDescription="Randomize Persona Traits" />
            <Button android:id="@+id/btnRotate" android:text="Rotate" android:contentDescription="Rotate view" />
            <Button android:id="@+id/btnZoom" android:text="Zoom" android:contentDescription="Zoom view" />
        </LinearLayout>

        <com.grokgirls.studio.AvatarPreviewView
            android:id="@+id/avatarPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- CAMERA ANGLES -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/angleStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button android:id="@+id/angleFront" android:text="FRONT" android:contentDescription="Front Portrait" />
                <Button android:id="@+id/angleThreeQuarter" android:text="3/4" android:contentDescription="Three-quarter angle" />
                <Button android:id="@+id/angleSide" android:text="SIDE" android:contentDescription="Side profile" />
                <Button android:id="@+id/angleBack" android:text="BACK" android:contentDescription="Back silhouette" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- OPTIONS -->
    <ScrollView
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:background="#141820">

        <LinearLayout
            android:id="@+id/optionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/optionsHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="APPEARANCE"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button android:id="@+id/catHairStyle" android:text="HAIR STYLE" />
                <Button android:id="@+id/catHairColor" android:text="HAIR COLOR" />
                <Button android:id="@+id/catMakeup" android:text="MAKEUP" />
                <Button android:id="@+id/catEyebrows" android:text="EYEBROWS" />
                <Button android:id="@+id/catSceneStyle" android:text="SCENE STYLE" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailsHeader"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:text="DETAILS"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <CheckBox android:id="@+id/tattooToggle" android:text="Tattoos" />
            <CheckBox android:id="@+id/augmentToggle" android:text="Augmentations" />

            <EditText
                android:id="@+id/avatarId"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Avatar ID" />

            <Button android:id="@+id/btnLoadOutfit" android:text="Load Outfit" android:contentDescription="Load outfit preset" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btnCancel" android:text="Cancel" android:contentDescription="Discard draft" />
                <Button android:id="@+id/btnSave" android:text="SAVE" android:contentDescription="Save avatar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
