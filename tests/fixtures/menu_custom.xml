<?xml version="1.0" encoding="utf-8"?>
<!-- Valid custom menu (native format) — proves the XML actually drives the UI. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#101217">
  <LinearLayout android:id="@+id/navigationRail" android:orientation="vertical" android:background="#171A21">
    <Button android:id="@+id/btnGallery" android:text="Gallery" android:contentDescription="ARCHIVE CUSTOM" />
    <Button android:id="@+id/btnPresets" android:text="Presets" android:contentDescription="Preset Identities" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:orientation="vertical">
    <LinearLayout android:id="@+id/headerBar" android:orientation="horizontal">
      <Button android:id="@+id/btnRandom" android:text="Random" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="92dp">
      <LinearLayout android:id="@+id/angleStrip" android:orientation="horizontal">
        <Button android:id="@+id/angleFront" android:text="FRONT" />
      </LinearLayout>
    </HorizontalScrollView>
  </LinearLayout>
  <ScrollView android:layout_width="340dp" android:background="#141820">
    <LinearLayout android:id="@+id/optionsPanel" android:orientation="vertical">
      <LinearLayout android:id="@+id/optionsContainer" android:orientation="vertical">
        <Button android:id="@+id/catMakeup" android:text="COSMETICS" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
